# Copy this file to .env (it is never pushed to GitHub)
NODE_ENV=development
PORT=3000
# Origin allowed by CORS (the frontend URL)
FRONTEND_ORIGIN=http://localhost:5173
# PostgreSQL connection. Must match the credentials in the root .env
# (URL-encode special characters in the password)
DATABASE_URL=postgresql://taskapp:change-this-password@127.0.0.1:5432/taskapp
